{
  "name": "dlc-yolo",
  "version": "2.0.0",
  "displayName": "DLC-YOLO",
  "description": "Automated software development lifecycle — intake issues, spec them, implement, review, and ship PRs with configurable human gates.",
  "author": "haid",
  "homepage": "https://github.com/hai-dvash/kiro-crew-yolo-dlc",
  "repository": "https://github.com/hai-dvash/kiro-crew-yolo-dlc",
  "license": "Apache-2.0",
  "tags": ["sdlc", "automation", "pipeline", "developer-tools"],
  "defaultEnabled": true,
  "agents": [
    "agents/pipeline-orchestrator.json",
    "agents/intent-agent.json",
    "agents/spec-agent.json",
    "agents/design-agent.json",
    "agents/impl-agent.json",
    "agents/review-agent.json",
    "agents/dlcyolo-readonly.json",
    "agents/dlcyolo-authoring.json",
    "agents/dlcyolo-builder.json",
    "agents/dlcyolo-coordinator.json"
  ],
  "skills": [
    "skills/pipeline-workflow",
    "skills/dlc-yolo",
    "skills/conversation-digest"
  ],
  "permissions": {
    "api": [
      "/api/apps/dlc-yolo",
      "/api/apps/dlc-yolo/*",
      "/apps/dlc-yolo",
      "/apps/dlc-yolo/*",
      "/api/file-read",
      "/api/file-write",
      "/api/ws",
      "/api/chat",
      "/api/chat/*"
    ],
    "storage": true,
    "mcpTools": [
      "kirocrew-core::spawn_run",
      "kirocrew-core::spawn_list",
      "kirocrew-core::select_crew",
      "kirocrew-core::send_message",
      "kirocrew-core::ask_question",
      "kirocrew-core::task_run",
      "kirocrew-cron::cron_add",
      "kirocrew-cron::cron_list",
      "kirocrew-cron::cron_pause",
      "kirocrew-cron::cron_resume",
      "kirocrew-cron::cron_remove"
    ]
  },
  "dependencies": {
    "optionalCommands": ["gh"]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health"
  },
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/dlc-yolo",
        "label": "DLC-YOLO",
        "icon": "RefreshCw"
      }
    ]
  },
  "iconUrl": "/app-assets/dlc-yolo/icon.svg",
  "crons": [
    {
      "name": "dlc-yolo-advance",
      "every": 120,
      "script": "~/.kiro/crew/crons/dlc_yolo_advance.py:advance"
    },
    {
      "name": "dlc-yolo-spawns",
      "every": 30,
      "script": "~/.kiro/crew/crons/dlc_yolo_spawns.py:snapshot"
    }
  ]
}
